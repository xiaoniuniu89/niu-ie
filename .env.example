# ==============================================================================
# NIU WEB AGENCY (.env.example)
# Copy this file to .env.local and fill in your secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Email Service (Gmail SMTP for Contact & Sample Request Notifications)
# ------------------------------------------------------------------------------
GMAIL_USER="niuwebdev@gmail.com"
GMAIL_APP_PASSWORD="your-16-digit-app-password"

# ------------------------------------------------------------------------------
# 2. Automated GitHub Issue Pipeline (Claude Code / Antigravity AI Prompts)
# Target Repo: Private CRM repository for client sample requests & LLM prompts
# ------------------------------------------------------------------------------
GITHUB_TOKEN="github_pat_11A..."
GITHUB_REPO="xiaoniuniu89/nii-client-leads"

# ------------------------------------------------------------------------------
# 3. UploadThing Cloud Storage (S3 CDN Uploads for Pamphlets, Flyers & Logos)
# Get keys at: https://uploadthing.com
# ------------------------------------------------------------------------------
UPLOADTHING_TOKEN="your-uploadthing-token"
UPLOADTHING_SECRET="your-uploadthing-secret"
UPLOADTHING_APP_ID="your-uploadthing-app-id"

# ------------------------------------------------------------------------------
# 4. Google Drive Folder Request Drop Box (Fallback Upload Link)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_DRIVE_UPLOAD_URL="https://drive.google.com/drive/folders/1ZiVxr1gCyo-zmeX80l1yJvmEe5HWse8t?usp=drive_link"

# ------------------------------------------------------------------------------
# 5. AI Integration (OpenAI / Gemini)
# ------------------------------------------------------------------------------
AI_PROVIDER="openai"
AI_API_KEY="sk-proj-your-api-key"
AI_MODEL="gpt-4o-mini"
